{
    "name": "eamirgh/basalam-laravel",
    "description": "Comprehensive Laravel package for Basalam API Gateway and Core with DTO interface contracts and zero third-party SDK dependencies",
    "keywords": [
        "laravel",
        "basalam",
        "ecommerce",
        "api",
        "gateway",
        "eamirgh"
    ],
    "homepage": "https://github.com/eamirgh/basalam-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Amir Ghaffari",
            "homepage": "https://github.com/eamirgh"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Eamirgh\\Basalam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eamirgh\\Basalam\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Eamirgh\\Basalam\\BasalamServiceProvider"
            ],
            "aliases": {
                "Basalam": "Eamirgh\\Basalam\\Facades\\Basalam"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
